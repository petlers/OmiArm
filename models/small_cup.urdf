<?xml version="1.0"?>
<robot name="small_cup">
  <!-- 小圆柱杯：直径 40mm，高 80mm。尺寸适配 Panda 夹爪（最大张开 70mm） -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.15" />
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0"
          izz="0.0001" />
    </inertial>
    <visual>
      <origin xyz="0 0 -0.04" rpy="0 0 0" />
      <geometry><cylinder radius="0.02" length="0.08" /></geometry>
      <material name="cup"><color rgba="0.2 0.7 0.9 0.7" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.04" rpy="0 0 0" />
      <geometry><cylinder radius="0.02" length="0.08" /></geometry>
    </collision>
  </link>
</robot>
