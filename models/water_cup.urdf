<?xml version="1.0"?>
<robot name="water_cup">
  <!--
    实心圆柱水杯（杯壁有一定厚度，适合两指夹爪从侧面夹持）
    底部在 z = -0.06m（半径 0.035m，高 0.12m）
    Panda 两指 Y 方向夹持圆柱侧面，接触面积大，能稳稳夹起。
  -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.2" />
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0"
          izz="0.0002" />
    </inertial>

    <!-- 杯身：实心圆柱（带一点内腔感，用半透明材质） -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.035" length="0.12" />
      </geometry>
      <material name="glass">
        <color rgba="0.2 0.7 0.9 0.6" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.035" length="0.12" />
      </geometry>
      <lateralFriction value="1.2" />
    </collision>
  </link>
</robot>
